# Database connection (PostgreSQL)
# Example: postgresql://username:password@localhost:5432/database_name
DATABASE_URL=

# SMTP / Email transport
# Used to send verification codes and (future) password-reset links via nodemailer
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Application base URL
# Used to construct links in outgoing emails (e.g. password reset)
# Defaults to http://localhost:3000 in development if not set
APP_URL=

# Flutterwave payment keys (not required for authentication-only testing)
# Obtain from: https://app.flutterwave.com → Settings → API Keys
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_SECRET_HASH=